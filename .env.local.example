# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Site URL (used in notification links) ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aldimmo.fr

# ── Resend (email notifications) ────────────────────────────────────────────
# Create a free account at https://resend.com, add your domain, get an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@aldimmo.fr
RESEND_FROM_NAME=ALD Immo

# ── Twilio (SMS notifications) ──────────────────────────────────────────────
# Create an account at https://twilio.com, buy a phone number, get credentials
# Phone numbers must be in E.164 format: +33612345678
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+33xxxxxxxxx
